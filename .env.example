# Database connection
DATABASE_URL= # PostgreSQL connection string (e.g. postgres://user:password@host:5432/db?schema=jobportal)

# Authentication & Security
JWT_SECRET= # Secret key for signing and verifying JSON Web Tokens
NODE_ENV= # Environment mode: production or development

# Server & Network Configuration (CloudLinux / Passenger)
PORT= # Port provided by Passenger / hosting runtime (do not hardcode)
HOSTNAME= # Server bind host (e.g. 0.0.0.0 or localhost)
NEXT_PUBLIC_APP_URL= # Public base URL of the application (e.g. https://netbondhu.com)
NEXT_PUBLIC_BUILD_SHA= # Short git commit SHA injected at build time for footer build stamp
UPLOAD_DIR= # Dedicated persistent directory for user uploads outside deploy directory

# SMTP / Email Server Settings
SMTP_HOST= # SMTP server host (e.g. smtp.gmail.com)
SMTP_PORT= # SMTP port (465 for SSL or 587 for TLS)
SMTP_USER= # SMTP username / Gmail address
SMTP_PASS= # SMTP password / 16-character Google App Password
SMTP_FROM= # Sender display name and email address

# SMS Gateway Configuration
SMS_PROVIDER= # SMS provider identifier (e.g. LOG_SANDBOX)
SMS_API_KEY= # SMS gateway API key
SMS_SENDER_ID= # SMS approved sender ID / mask
SMS_API_URL= # SMS gateway endpoint URL

# Payment Gateway Configuration
PAYMENT_PROVIDER= # Payment provider identifier (e.g. SANDBOX)
PAYMENT_STORE_ID= # Merchant store ID
PAYMENT_STORE_PASSWORD= # Merchant store password
PAYMENT_SANDBOX= # Payment sandbox mode flag (true / false)
